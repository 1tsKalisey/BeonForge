{
  "name": "@beonforge/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "demo": "vitest run test/recovery.test.ts --silent=false",
    "demo:bugfix": "node examples/bugfix/cli.mjs"
  },
  "dependencies": {
    "@beonforge/contracts": "workspace:*",
    "@beonforge/persistence": "workspace:*"
  },
  "devDependencies": {
    "@beonforge/workspace": "workspace:*"
  }
}
